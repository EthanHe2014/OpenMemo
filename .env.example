# OpenMemo Configuration

# AI Endpoint
AI_BASE_URL=https://yuanyuaicloud.cn/v1
AI_API_KEY=your-api-key-here
AI_MODEL=glm-5.2

# Tavily 搜索（NEWS_JOB 实时新闻；可复用 OpenClaw 的配置）
TAVILY_API_KEY=tvly-xxx-your-tavily-key

# Feishu Bot
FEISHU_APP_ID=
FEISHU_APP_SECRET=
