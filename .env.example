# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=18890

# TTS
TTS_VOICE=zh-CN-XiaoxiaoNeural

# Data
DATA_DIR=./data
DB_PATH=./data/openmemo.db
AUDIO_DIR=./data/audio