# OpenMemo Configuration

# AI Endpoint（任意 OpenAI 兼容服务均可：BaseURL + API Key + 模型名）
# 默认指向 yuanyuaicloud，模型默认 glm-5.2；换成你自己的服务就改下面三项
AI_BASE_URL=https://yuanyuaicloud.cn/v1
AI_API_KEY=your-api-key-here
AI_MODEL=glm-5.2

# Tavily 搜索（NEWS_JOB 实时新闻；可复用 OpenClaw 的配置）
TAVILY_API_KEY=tvly-xxx-your-tavily-key

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=18890

# TTS
TTS_VOICE=zh-CN-XiaoxiaoNeural

# Data
DATA_DIR=./data
DB_PATH=./data/openmemo.db
AUDIO_DIR=./data/audio