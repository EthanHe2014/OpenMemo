# OpenMemo Configuration Template
# ================================
# 建议不要手改这个文件。直接运行:
#     ./start.sh
# 一键启动会自动进入交互式向导，引导你选择 AI 提供商 / 搜索服务 / 偏好，
# 并自动写出底下的 .env。
#
# 若确实要手动配置，把本文件复制为 .env 后填写下面的空值即可。
# 【没有任何默认模型、默认密钥、默认接口地址】——不填服务就无法连接 AI。

# AI Endpoint（由设置向导选择提供商并填写；BaseURL + API Key + 模型名均必填）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 搜索（可选，做「每日新闻」任务时需要；不填则新闻由 AI 生成）
# SEARCH_PROVIDER 取值: tavily / brave / serper / custom（留空 = 不启用）
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=18890

# TTS（edge-tts 音色，默认中文女声 晓晓）
TTS_VOICE=zh-CN-XiaoxiaoNeural

# Data（一般不用改）
DATA_DIR=./data
DB_PATH=./data/openmemo.db
AUDIO_DIR=./data/audio
